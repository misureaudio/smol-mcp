+# ---------------------------------------------------------------------------
+# Configurable async-bridge timeout (was a hardcoded 300 s)
+# ---------------------------------------------------------------------------
+
+class TestAsyncBridgeTimeout:
+    """The running-loop branch of _run_async() used to wait a hardcoded 300 s
+    (future.result(timeout=300)), killing legitimately slow tools (e.g. vision
+    on a local model) with a bare TimeoutError before the underlying HTTP call
+    - which has its own, much larger, configurable timeout - finished. The cap
+    is now resolved via agent.deadline.resolve_timeout:
+    timeouts.async_bridge (config) > HERMES_ASYNC_TOOL_TIMEOUT_S (env) > 300 s
+    default; 0/negative = no cap (future.result waits indefinitely)."""
+
+    def _fn(self, monkeypatch):
+        import hermes_cli.config as _cfg
+        from model_tools import _async_bridge_timeout_s
+        monkeypatch.delenv("HERMES_ASYNC_TOOL_TIMEOUT_S", raising=False)
+        monkeypatch.setattr(_cfg, "load_config_readonly", lambda: {})
+        return _async_bridge_timeout_s
+
+    def test_default_is_300(self, monkeypatch):
+        assert self._fn(monkeypatch)() == 300.0
+
+    def test_env_override(self, monkeypatch):
+        f = self._fn(monkeypatch)
+        monkeypatch.setenv("HERMES_ASYNC_TOOL_TIMEOUT_S", "14400")
+        assert f() == 14400.0
+
+    def test_env_zero_is_unbounded(self, monkeypatch):
+        f = self._fn(monkeypatch)
+        monkeypatch.setenv("HERMES_ASYNC_TOOL_TIMEOUT_S", "0")
+        assert f() is None
+
+    def test_config_wins_over_env(self, monkeypatch):
+        import hermes_cli.config as _cfg
+        from model_tools import _async_bridge_timeout_s
+        monkeypatch.delenv("HERMES_ASYNC_TOOL_TIMEOUT_S", raising=False)
+        monkeypatch.setattr(_cfg, "load_config_readonly",
+                            lambda: {"timeouts": {"async_bridge": 900}})
+        assert _async_bridge_timeout_s() == 900.0
